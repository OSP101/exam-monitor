# Copy this file to `.env` and fill in real values before deploying.
# docker-compose reads `.env` automatically and injects these into the app container.

# Master admin PIN - accepts ANY exam's admin PIN too, so use something strong.
ADMIN_MASTER_PIN=change-me-to-a-strong-master-pin

# Secret used to sign the admin session cookie (HMAC-SHA256).
# Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Optional: host port that docker-compose maps to the app (default 80).
# NOTE: With the nginx HTTPS proxy in place the app is no longer exposed on a
# host port — nginx listens on 80 (redirect) and 443 (HTTPS) instead.
# HOST_PORT=80
